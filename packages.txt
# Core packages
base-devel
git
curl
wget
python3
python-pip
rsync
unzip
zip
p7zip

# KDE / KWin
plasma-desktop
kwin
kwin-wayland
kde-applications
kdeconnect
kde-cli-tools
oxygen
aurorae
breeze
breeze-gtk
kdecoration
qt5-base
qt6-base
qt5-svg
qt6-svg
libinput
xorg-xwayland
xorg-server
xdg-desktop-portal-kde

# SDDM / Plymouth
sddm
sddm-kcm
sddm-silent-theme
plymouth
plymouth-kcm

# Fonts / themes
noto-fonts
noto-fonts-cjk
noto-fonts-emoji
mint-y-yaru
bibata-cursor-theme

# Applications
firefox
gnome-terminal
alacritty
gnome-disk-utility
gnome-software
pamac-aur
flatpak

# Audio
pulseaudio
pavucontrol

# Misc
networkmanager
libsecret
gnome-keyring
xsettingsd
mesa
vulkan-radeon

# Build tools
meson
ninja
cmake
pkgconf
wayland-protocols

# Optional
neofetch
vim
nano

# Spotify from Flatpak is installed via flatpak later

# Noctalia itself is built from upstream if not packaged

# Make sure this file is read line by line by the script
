#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$ROOT/config"
WALLPAPER_DIR="$ROOT/wallpapers"
USER_HOME="${HOME}"

log() { echo "[$(date +%H:%M:%S)] $*"; }

log "Checking Arch Linux..."
if [[ ! -f /etc/arch-release ]]; then
  echo "This installer is designed for Arch Linux only." >&2
  exit 1
fi

log "Installing base system packages..."
sudo pacman -Syu --noconfirm
sudo pacman -S --needed --noconfirm --disable-download-timeout \
  base-devel git curl wget pacman-contrib unzip zip rsync p7zip \
  kde-applications kdeconnect kwin kwin-wayland plasma-desktop plasma-nm \
  sddm sddm-kcm sddm-silent-theme plymouth plymouth-kcm \
  breeze breeze-gtk kdecoration gstreamer \
  noto-fonts noto-fonts-cjk noto-fonts-emoji \
  gnome-terminal alacritty gnome-software pamac-aur flatpak \
  gnome-keyring libsecret xdg-desktop-portal-kde xdg-user-dirs \
  networkmanager nm-connection-editor \
  pulseaudio pavucontrol \
  firefox gnome-disk-utility neofetch \
  git curl wget python3 python-pip \
  libinput libinput-gestures \
  libva-mesa-driver Mesa vulkan-radeon \
  qt5-base qt6-base qt5-svg qt6-svg gsettings-desktop-schemas \
  xorg-xwayland xorg-server \
  kvantum \
  mint-y-yaru icon-theme-bibata modern-cursor-theme || true

log "Installing Noctalia deps and application packages..."
sudo pacman -S --needed --noconfirm --disable-download-timeout \
  base-devel meson ninja cmake git wayland-protocols pkgconf python3 || true

if ! command -v noctalia >/dev/null 2>&1; then
  log "Building Noctalia from upstream..."
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' EXIT
  git clone --depth 1 https://github.com/noctalia-dev/noctalia.git "$tmpdir/noctalia"
  cd "$tmpdir/noctalia"
  meson setup build --prefix=/usr
  ninja -C build
  sudo ninja -C build install
fi

log "Installing Flatpak apps..."
flatpak install -y flathub com.spotify.Client org.gnome.Software org.freedesktop.Platform.GL.default 2>/dev/null || true

log "Installing Spicetify..."
if ! command -v spicetify >/dev/null 2>&1; then
  curl -fsSL https://raw.githubusercontent.com/spicetify/spicetify-cli/master/install.sh | sh
fi
mkdir -p "$USER_HOME/.config/spicetify"
cp -f "$CONFIG_DIR/spicetify/config-xpui.ini" "$USER_HOME/.config/spicetify/config-xpui.ini"
spicetify config current_theme marketplace
spicetify config custom_apps marketplace
spicetify config inject_css 1
spicetify config inject_theme_js 1
spicetify config replace_colors 1
spicetify apply || true

log "Copying theme configs into $USER_HOME/.config"
mkdir -p "$USER_HOME/.config" "$USER_HOME/.config/gtk-3.0" "$USER_HOME/.config/gtk-4.0" "$USER_HOME/.config/environment.d" "$USER_HOME/.config/noctalia"
cp -f "$CONFIG_DIR/kdeglobals" "$USER_HOME/.config/kdeglobals"
cp -f "$CONFIG_DIR/kwinrc" "$USER_HOME/.config/kwinrc"
cp -f "$CONFIG_DIR/kglobalshortcutsrc" "$USER_HOME/.config/kglobalshortcutsrc"
cp -f "$CONFIG_DIR/plasmarc" "$USER_HOME/.config/plasmarc"
cp -f "$CONFIG_DIR/gtk-3.0/settings.ini" "$USER_HOME/.config/gtk-3.0/settings.ini"
cp -f "$CONFIG_DIR/gtk-4.0/settings.ini" "$USER_HOME/.config/gtk-4.0/settings.ini"
cp -f "$CONFIG_DIR/noctalia/settings.json" "$USER_HOME/.config/noctalia/settings.json"
cp -f "$CONFIG_DIR/noctalia/colors.json" "$USER_HOME/.config/noctalia/colors.json"
cp -f "$CONFIG_DIR/noctalia/plugins.json" "$USER_HOME/.config/noctalia/plugins.json"

log "Setting cursor and UI environment"
mkdir -p "$USER_HOME/.config/environment.d"
cat > "$USER_HOME/.config/environment.d/cursor.conf" <<'EOF'
XCURSOR_THEME=Bibata-Modern-Classic
XCURSOR_SIZE=24
EOF

# KDE environment knobs
mkdir -p "$USER_HOME/.config/gtk-3.0" "$USER_HOME/.config/gtk-4.0"
cat > "$USER_HOME/.config/gtk-3.0/settings.ini" <<'EOF'
[Settings]
gtk-application-prefer-dark-theme=true
gtk-button-images=true
gtk-cursor-blink=true
gtk-cursor-blink-time=1000
gtk-cursor-theme-name=Bibata-Modern-Classic
gtk-cursor-theme-size=24
gtk-decoration-layout=icon:minimize,maximize,close
gtk-enable-animations=true
gtk-font-name=Noto Sans,  10
gtk-icon-theme-name=Mint-Y-Yaru
gtk-menu-images=true
gtk-modules=colorreload-gtk-module
gtk-primary-button-warps-slider=true
gtk-sound-theme-name=freedesktop
gtk-toolbar-style=3
gtk-xft-dpi=98304
EOF

cat > "$USER_HOME/.config/gtk-4.0/settings.ini" <<'EOF'
[Settings]
gtk-application-prefer-dark-theme=true
gtk-button-images=true
gtk-cursor-blink=true
gtk-cursor-blink-time=1000
gtk-cursor-theme-name=Bibata-Modern-Classic
gtk-cursor-theme-size=24
gtk-decoration-layout=icon:minimize,maximize,close
gtk-enable-animations=true
gtk-font-name=Noto Sans,  10
gtk-icon-theme-name=Mint-Y-Yaru
gtk-menu-images=true
gtk-modules=colorreload-gtk-module
gtk-primary-button-warps-slider=true
gtk-sound-theme-name=freedesktop
gtk-toolbar-style=3
gtk-xft-dpi=98304
EOF

log "Setting SDDM theme and session..."
sudo systemctl enable sddm.service 2>/dev/null || true
sudo mkdir -p /usr/share/wayland-sessions
sudo tee /usr/share/wayland-sessions/kwin-noctalia.desktop > /dev/null <<'EOF'
[Desktop Entry]
Name=KWin Noctalia
Comment=KWin mit Noctalia Shell
Exec=env XDG_CURRENT_DESKTOP=KDE XDG_SESSION_DESKTOP=KDE kwin_wayland --no-lockscreen --xwayland -- noctalia
Type=Application
EOF

sudo tee /etc/sddm.conf > /dev/null <<'EOF'
[General]
InputMethod=qtvirtualkeyboard
GreeterEnvironment=QML2_IMPORT_PATH=/usr/share/sddm/themes/silent/components/,QT_IM_MODULE=qtvirtualkeyboard

[Theme]
Current=silent
EOF

log "Setting Plymouth theme..."
sudo sed -i 's/^Theme=.*/Theme=cachyos/' /etc/plymouth/plymouthd.conf
sudo systemctl enable plymouth-quit-wait.service 2>/dev/null || true
sudo systemctl enable --now NetworkManager.service 2>/dev/null || true

log "Installing default wallpaper..."
mkdir -p "$USER_HOME/Wallpaper" "$USER_HOME/Dokumente/Wallpaper"
if [[ -f "$WALLPAPER_DIR/dark-waves.jpg" ]]; then
  cp -f "$WALLPAPER_DIR/dark-waves.jpg" "$USER_HOME/Dokumente/Wallpaper/dark-waves.jpg"
  cp -f "$WALLPAPER_DIR/dark-waves.jpg" "$USER_HOME/Wallpaper/dark-waves.jpg"
fi

log "Setting Plasma wallpaper, if available..."
if [[ -f "$USER_HOME/Dokumente/Wallpaper/dark-waves.jpg" ]]; then
  kwriteconfig5 --file "$USER_HOME/.config/plasmarc" --group Wallpapers --key usersWallpapers "$USER_HOME/Dokumente/Wallpaper/dark-waves.jpg"
fi

log "Setting Qt/KDE theme values..."
kwriteconfig5 --file "$USER_HOME/.config/kdeglobals" --group Icons --key Theme Mint-Y-Yaru
kwriteconfig5 --file "$USER_HOME/.config/kdeglobals" --group KWin --key theme WillowDark
kwriteconfig5 --file "$USER_HOME/.config/kdeglobals" --group KDE --key LookAndFeelPackage org.kde.breezedark.desktop

log "Enabling SDDM startup if already installed"
if command -v systemctl >/dev/null 2>&1; then
  sudo systemctl daemon-reload
  sudo systemctl enable sddm.service 2>/dev/null || true
  sudo systemctl set-default graphical.target 2>/dev/null || true
fi

log "Finalizing..."
cat <<'EOF'
Installation finished.

Next steps:
1. Log out and select 'KWin Noctalia' in SDDM or set SDDM as display manager.
2. Reboot once to ensure Plymouth + SDDM + KWin load correctly.
3. If the wallpaper is not present, copy your preferred image into ~/Dokumente/Wallpaper/dark-waves.jpg
EOF

